# Public business details (used to render the website)
ORACREST_EMAIL=info@oracrest.in
ORACREST_LOCATION=Noida, India
ORACREST_FOUNDED=2023
ORACREST_LINKEDIN_URL=

# Form delivery (Resend API)
RESEND_API_KEY=
EMAIL_FROM=

# Optional: set this to a verified ORACREST email address; defaults to ORACREST_EMAIL.
CONTACT_EMAIL=

# PostgreSQL (use a managed PostgreSQL URL with sslmode=require in production)
DATABASE_URL=
DB_POOL_MAX=10

# Single administrator account. Generate a password hash with `npm run admin:hash`.
ADMIN_EMAIL=admin@oracrest.in
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
